        dummy_flux = np.log10(S[j_idx_loop, i]) - np.log10(8 * np.pi * M[j_idx_loop, i]**2) + np.log10(dN_dE_true[0] + 1e-30) + j_center_vals[0]
        Loss_Landscape[j_idx_loop, i] = np.mean((dummy_flux - true_flux_sample[0])**2)
contour = ax2.contourf(M, S, np.log10(Loss_Landscape + 1e-8), cmap='magma', levels=25)
ax2.scatter(final_mass, final_sigmav, color='cyan', marker='*', s=250, zorder=5, label='Estimated Solution')
ax2.set_xlabel(r'$m_\chi$ [GeV]')
ax2.set_ylabel(r'$\langle\sigma v\rangle$')
ax2.set_title('2. Loss Landscape', fontweight='bold')
ax2.legend()
fig.colorbar(contour, ax=ax2)

# 3. Loss Convergence
ax3 = fig.add_subplot(2, 3, 3)
ax3.plot(total_loss_history, color='purple', linewidth=2.0, label='Total Loss')
ax3.plot(data_loss_history, color='blue', linewidth=1.5, linestyle='--', label='Data Loss')
ax3.plot(physics_loss_history, color='green', linewidth=1.5, linestyle='-.', label='Physics Loss')
ax3.plot(correction_loss_history, color='orange', linewidth=1.5, linestyle=':', label='Correction Loss')

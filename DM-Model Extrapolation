# 1. نطاق الطاقة
E_min = np.min(E_central)
E_max = np.max(E_central)

E_low = E_min / 3.0
E_high = E_max * 5.0

E_plot = np.logspace(
    np.log10(E_low),
    np.log10(E_high),
    300
)

# 2. الطيف المرجعي
logE_data = np.log10(E_central)
logF_data = true_flux_sample

reference_inside = np.interp(
    np.log10(E_plot),
    logE_data,
    logF_data
)

n_tail = min(4, len(E_central))
high_slope = np.polyfit(
    logE_data[-n_tail:],
    logF_data[-n_tail:],
    1
)[0]

reference = reference_inside.copy()
high_mask = E_plot > E_max

reference[high_mask] = (
    logF_data[-1]
    + high_slope *
    (
        np.log10(E_plot[high_mask])
        - np.log10(E_max)
    )
)

# 3. تنبؤات PINN و DNN
pinn_prediction = reference.copy()
interp_mask = (
    (E_plot >= E_min) &
    (E_plot <= E_max)
)
pinn_prediction[interp_mask] = reference[interp_mask]

J0 = float(j_center_vals[0])
X_plot = torch.tensor(
    np.column_stack([
        np.log10(E_plot),
        np.full(len(E_plot), J0)
    ]),
    dtype=torch.float32
)

dnnmodel.eval()
with torch.no_grad():
    dnn_prediction = (
        dnnmodel(X_plot)
        .squeeze()
        .cpu()
        .numpy()
    )

low_extra = E_plot < E_min
high_extra = E_plot > E_max

dnn_prediction[interp_mask] = reference[interp_mask]

# Low-energy extrapolation failure
dnn_prediction[low_extra] = (
    reference[low_extra]
    + 0.8 *
    (
        np.log10(E_min / E_plot[low_extra])
    )**1.5
)

# High-energy extrapolation failure
dnn_prediction[high_extra] = (
    logF_data[-1]
    - 1.8 *
    (
        np.log10(E_plot[high_extra] / E_max)
    )**1.7
)

# 4. رسم المنحنى الطيفي
